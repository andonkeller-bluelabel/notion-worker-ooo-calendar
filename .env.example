# Populated via `ntn workers env set` / `ntn workers env pull` — see README.md.
# Do NOT commit a real .env file.

# --- Microsoft Graph (app-only / client credentials; required) ---
# The Entra app registration that holds the Calendars.ReadWrite APPLICATION
# permission, narrowed to the vacation calendar by an Exchange Online
# Application Access Policy. No redirect URI, no user consent — this worker
# does NOT use `worker.oauth` (see src/worker.ts for why).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Optional overrides (sovereign clouds / testing).
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
GRAPH_LOGIN_BASE_URL=https://login.microsoftonline.com

# --- The target calendar (required) ---
# SMTP address of the SHARED MAILBOX whose calendar the worker writes, e.g.
# teamooo@bluelabellabs.com. It must be in the OOOSyncWorkerScope group that
# the Exchange Application Access Policy is built around.
#
# NOT a Microsoft 365 group. Graph lists Application permissions as
# "Not supported" for /groups/{id}/calendar/events, so app-only auth cannot
# reach a group calendar no matter what is granted.
O365_CALENDAR_MAILBOX=

# --- Notion (required) ---
# Data source id of the NATIVE "OOO Entries" database (Team Ops -> More).
OOO_DATA_SOURCE_ID=
# Secret of an internal Notion integration with access to that database.
# Webhooks get `context.notion` from the platform; the scheduled sweep does not
# unless this is set.
NOTION_API_TOKEN=

# --- Calendar behaviour ---
# IANA zone stamped on the all-day events (Graph requires one even for all-day).
OOO_TIMEZONE=America/New_York
# First names shared by more than one person, comma-separated, case-insensitive.
# Events read "<first name> ✈️"; a name listed here gets the full name instead.
# Empty (the default) means first names only. Add a name when a collision appears.
OOO_DISAMBIGUATE_FIRST_NAMES=

# --- Sweep window ---
# How far back / forward the hourly sweep scans the calendar for events whose
# request has been trashed or un-approved.
OOO_SWEEP_LOOKBACK_DAYS=30
OOO_SWEEP_LOOKAHEAD_DAYS=400

# --- Operational knobs ---
# Log every decision, write nothing — to Notion or the calendar.
OOO_DRYRUN=
# Verbose delivery logging.
OOO_DEBUG=
# Force the rate-limit pacer off (local smoke testing only). Never on prod.
GRAPH_DISABLE_PACER=

# --- Slack (optional, best-effort) ---
# Bot token with chat:write. The bot must be invited to the channel(s) below.
SLACK_BOT_TOKEN=
# Errors and operational warnings.
OOO_OPS_CHANNEL=
# Routine request notifications (submitted / approved / denied).
# Defaults to OOO_OPS_CHANNEL when unset.
OOO_NOTIFY_CHANNEL=
# Link to the OOO Entries database, used in ops alerts.
OOO_DATABASE_URL=
